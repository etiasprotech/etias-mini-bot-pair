}


/* =========================================
   IMAGE FALLBACK
========================================= */

function setupImageFallback(img){

    if(!img) return;

    const fallbacks=[
        "/media/bot.jpg",
        "/media/bot_image.png",
        "/media/bot.jpeg",
        "/media/bot.webp",
        "/media/logo.jpg"
    ];

    let index=0;

    img.addEventListener("error",function(){

        if(index < fallbacks.length){

            this.src=fallbacks[index++];

        }else{

            this.style.display="none";

        }

    });

}

setupImageFallback(
    document.getElementById("headerImg")
);

setupImageFallback(
    document.getElementById("mainImg")
);


/* =========================================
   ELEMENTS
========================================= */

const numberInput =
    document.getElementById("number");

const submitBtn =
    document.getElementById("submit");

const pairResult =
    document.getElementById("pair-result");

const idleMessage =
    document.getElementById("idle-message");

const waitingMessage =
    document.getElementById("waiting-message");

const copyBtn =
    document.getElementById("copy-code");


let currentCode = "";
let currentPairingId = null;
let pollTimer = null;


/* =========================================
   NUMBER CLEANING
========================================= */

function cleanNumber(value){

    return String(value || "")
        .replace(/\D/g,"")
        .trim();

}


/* =========================================
   SHOW MESSAGE
========================================= */

function showResult(html){

    pairResult.innerHTML = html;

}


/* =========================================
   REQUEST PAIR CODE
========================================= */

async function requestPairCode(){

    const number =
        cleanNumber(numberInput.value);

    if(!number){

        showResult(`
            <div class="error-message">
                <i class="fas fa-circle-exclamation"></i>
                Enter your WhatsApp number.
            </div>
        `);

        return;

    }


    if(number.length < 10 || number.length > 15){

        showResult(`
            <div class="error-message">
                <i class="fas fa-circle-exclamation"></i>
                Enter a valid international phone number.
            </div>
        `);

        return;

    }


    if(pollTimer){

        clearInterval(pollTimer);
        pollTimer=null;

    }


    submitBtn.disabled=true;
    submitBtn.innerHTML=
        '<i class="fas fa-spinner fa-spin"></i> WAIT...';

    copyBtn.style.display="none";

    currentCode="";
    currentPairingId=null;


    showResult(`
        <p id="waiting-message" style="color:var(--green)">
            <i class="fas fa-spinner fa-spin"></i>
            Starting pairing...
        </p>
    `);


    try{

        /*
         * Existing backend endpoint:
         *
         * GET /code?number=2637XXXXXXXX
         */

        const response =
            await fetch(
                "/code?number="+encodeURIComponent(number),
                {
                    method:"GET",
                    cache:"no-store",
                    headers:{
                        "Accept":"application/json"
                    }
                }
            );


        const data =
            await response.json()
            .catch(()=>({}));


        if(!response.ok){

            throw new Error(
                data.error ||
                "Unable to start pairing"
            );

        }


        /*
         * Some backend versions return
         * the code immediately.
         */

        if(data.code){

            showPairingCode(
                data.code
            );

            return;

        }


        /*
         * Current ETIAS backend normally
         * returns a pairingId first.
         */

        if(data.pairingId){

            currentPairingId =
                data.pairingId;

            showResult(`
                <p style="color:var(--green)">
                    <i class="fas fa-spinner fa-spin"></i>
                    Waiting for WhatsApp pairing code...
                </p>
            `);

            startStatusPolling();

            return;

        }


        if(data.status){

            showResult(`
                <p style="color:var(--green)">
                    <i class="fas fa-spinner fa-spin"></i>
                    ${escapeHtml(data.status)}
                </p>
            `);

            if(data.id){

                currentPairingId=data.id;
                startStatusPolling();

            }

            return;

        }


        throw new Error(
            data.error ||
            "Pairing request was not accepted"
        );


    }catch(error){

        console.error(
            "Pairing error:",
            error
        );

        showResult(`
            <div class="error-message">
                <i class="fas fa-triangle-exclamation"></i>
                ${escapeHtml(
                    error.message ||
                    "Unable to start pairing"
                )}
                <br><br>
                Please wait a few seconds and try again.
            </div>
        `);

    }finally{

        submitBtn.disabled=false;

        submitBtn.innerHTML=
            '<i class="fas fa-key"></i> GET CODE';

        updateTotalUsers();

    }

}


/* =========================================
   STATUS POLLING
========================================= */

function startStatusPolling(){

    if(!currentPairingId){

        return;

    }


    let attempts=0;

    const maxAttempts=40;


    if(pollTimer){

        clearInterval(pollTimer);

    }


    pollTimer=setInterval(
        async()=>{

            attempts++;

            try{

                const response=
                    await fetch(
                        "/status/"+
                        encodeURIComponent(
                            currentPairingId
                        ),
                        {
                            cache:"no-store",
                            headers:{
                                "Accept":
                                    "application/json"
                            }
                        }
                    );


                const data=
                    await response.json()
                    .catch(()=>({}));


                if(data.code){

                    clearInterval(
                        pollTimer
                    );

                    pollTimer=null;

                    showPairingCode(
                        data.code
                    );

                    submitBtn.disabled=false;

                    submitBtn.innerHTML=
                        '<i class="fas fa-key"></i> GET CODE';

                    return;

                }


                /*
                 * Backend may use
                 * pairingCode instead.
                 */

                if(data.pairingCode){

                    clearInterval(
                        pollTimer
                    );

                    pollTimer=null;

                    showPairingCode(
                        data.pairingCode
                    );

                    submitBtn.disabled=false;

                    submitBtn.innerHTML=
                        '<i class="fas fa-key"></i> GET CODE';

                    return;

                }


                /*
                 * If connected before the code
                 * was displayed, tell the user.
                 */

                if(
                    data.connected === true ||
                    data.status === "connected"
                ){

                    clearInterval(
                        pollTimer
                    );

                    pollTimer=null;

                    showResult(`
                        <div class="success-message">
                            <i class="fas fa-circle-check"></i>
                            WhatsApp connected successfully.
                            <br><br>
                            Your SESSION_ID has been sent
                            to the connected WhatsApp account.
                        </div>
                    `);

                    return;

                }


                if(
                    data.status === "failed" ||
                    data.status === "error"
                ){

                    clearInterval(
                        pollTimer
                    );

                    pollTimer=null;

                    showResult(`
                        <div class="error-message">
                            <i class="fas fa-circle-xmark"></i>
                            ${
                                escapeHtml(
                                    data.error ||
                                    "Pairing failed"
                                )
                            }
                        </div>
                    `);

                    return;

                }


                if(attempts >= maxAttempts){

                    clearInterval(
                        pollTimer
                    );

                    pollTimer=null;

                    showResult(`
                        <div class="error-message">
                            <i class="fas fa-clock"></i>
                            Pairing request timed out.
                            Please try again.
                        </div>
                    `);

                }

            }catch(error){

                console.warn(
                    "Status polling:",
                    error
                );

                /*
                 * Do not immediately fail.
                 * Temporary network errors are common.
                 */

                if(attempts >= maxAttempts){

                    clearInterval(
                        pollTimer
                    );

                    pollTimer=null;

                    showResult(`
                        <div class="error-message">
                            Unable to check pairing status.
                            Please try again.
                        </div>
                    `);

                }

            }

        },
        1500
    );

}


/* =========================================
   DISPLAY CODE
========================================= */

function showPairingCode(code){

    currentCode =
        String(code || "")
        .trim();


    if(!currentCode){

        showResult(`
            <div class="error-message">
                Pairing code was empty.
            </div>
        `);

        return;

    }


    showResult(`

        <div>

            <div class="code-label">
                YOUR PAIRING CODE
            </div>

            <div class="code-value">
                ${escapeHtml(currentCode)}
            </div>

            <div
                style="
                    color:#78837c;
                    font-size:.72rem;
                    margin-top:9px;
                "
            >
                Enter this code in WhatsApp
            </div>

        </div>

    `);


    copyBtn.style.display="inline-block";

}


/* =========================================
   COPY CODE
========================================= */

copyBtn.addEventListener(
    "click",
    async()=>{

        if(!currentCode){

            return;

        }


        try{

            await navigator.clipboard.writeText(
                currentCode
            );

            copyBtn.innerHTML=
                '<i class="fas fa-check"></i> COPIED';

            setTimeout(()=>{

                copyBtn.innerHTML=
                    '<i class="fas fa-copy"></i> COPY CODE';

            },2000);

        }catch(error){

            /*
             * Fallback for browsers where
             * Clipboard API is unavailable.
             */

            const area=
                document.createElement("textarea");

            area.value=currentCode;

            document.body.appendChild(area);

            area.select();

            document.execCommand("copy");

            area.remove();

            copyBtn.innerHTML=
                '<i class="fas fa-check"></i> COPIED';

            setTimeout(()=>{

                copyBtn.innerHTML=
                    '<i class="fas fa-copy"></i> COPY CODE';

            },2000);

        }

    }
);


/* =========================================
   ENTER KEY
========================================= */

numberInput.addEventListener(
    "keydown",
    function(event){

        if(event.key==="Enter"){

            event.preventDefault();

            requestPairCode();

        }

    }
);


/* =========================================
   INPUT CLEANING
========================================= */

numberInput.addEventListener(
    "input",
    function(){

        this.value=
            this.value.replace(/\D/g,"");

    }
);


/* =========================================
   SUBMIT
========================================= */

submitBtn.addEventListener(
    "click",
    requestPairCode
);


/* =========================================
   ESCAPE HTML
========================================= */

function escapeHtml(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =========================================
   USER STATISTICS
========================================= */

async function updateTotalUsers(){

    const totalEl=
        document.getElementById(
            "total-users"
        );

    const onlineEl=
        document.getElementById(
            "online-users"
        );


    try{

        const response=
            await fetch(
                "/total-users",
                {
                    method:"GET",
                    cache:"no-store",
                    headers:{
                        "Accept":
                            "application/json"
                    }
                }
            );


        if(!response.ok){

            throw new Error(
                "HTTP "+response.status
            );

        }


        const data=
            await response.json();


        const total=
            Number(
                data.total ??
                data.count ??
                0
            );


        const online=
            Number(
                data.online ??
                0
            );


        totalEl.textContent=
            Number.isFinite(total)
                ? total.toLocaleString()
                : "0";


        onlineEl.textContent=
            Number.isFinite(online)
                ? online.toLocaleString()
                : "0";


    }catch(error){

        console.warn(
            "Statistics unavailable:",
            error
        );

        if(totalEl.textContent==="--"){

            totalEl.textContent="0";

        }

        if(onlineEl.textContent==="--"){

            onlineEl.textContent="0";

        }

    }

}


updateTotalUsers();


setInterval(
    updateTotalUsers,
    10000
);


/* =========================================
   PAGE VISIBILITY
========================================= */

document.addEventListener(
    "visibilitychange",
    function(){

        if(!document.hidden){

            updateTotalUsers();

        }

    }
);

